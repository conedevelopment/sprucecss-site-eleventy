{
  "type": "module",
  "scripts": {
    "build": "npm-run-all dist:delete sass:compile ui:compile eleventy:build",
    "dist:delete": "del-cli --force dist",
    "eleventy:build": "npx eleventy",
    "eleventy:serve": "npx eleventy --serve",
    "js:fix": "semistandard src/js/*.js src/_includes/ui/js/**/*.js --fix",
    "js:lint": "semistandard src/js/*.js src/_includes/ui/js/**/*.js",
    "sass:compile": "sass --load-path=node_modules --no-source-map --style=compressed src/scss:src/css",
    "sass:fix": "stylelint \"src/scss/**/*.scss\" \"src/_includes/ui/scss/**/*.scss\" --fix",
    "sass:lint": "stylelint \"src/scss/**/*.scss\" \"src/_includes/ui/scss/**/*.scss\"",
    "sass:watch": "sass --watch --update --load-path=node_modules --no-source-map --style=expanded src/scss:src/css",
    "start": "npm-run-all --parallel sass:watch ui:watch eleventy:serve",
    "ui:compile": "node scripts/build-ui-css.js",
    "ui:watch": "node scripts/build-ui-css.js --watch"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "date-fns": "^4.4.0",
    "del-cli": "^7.0.0",
    "dotenv": "^18.0.5",
    "himalaya": "^1.1.1",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.1.1",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "npm-run-all2": "^9.0.3",
    "pagefind": "^1.5.2",
    "sass": "^1.105.1",
    "semistandard": "^17.0.0",
    "slugify": "^1.6.9",
    "sprucecss": "^3.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-order": "^8.1.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10",
    "yarn": "please-use-npm"
  },
  "devDependencies": {
    "@types/linkify-it": "^5.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mdurl": "^2.0.0"
  },
  "semistandard": {
    "env": [
      "browser"
    ]
  }
}
